{
  "name": "holdfast-protocol",
  "version": "1.0.0",
  "description": "Trustworthy payment decisions for AI-powered commerce on PayPal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/server\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:proof": "vitest run tests/proof-suite.test.ts",
    "health-check": "node scripts/health-check.mjs",
    "package:submission": "node scripts/package-submission.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "author": "Holdfast Team",
  "license": "MIT"
}
