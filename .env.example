# Server Configuration
PORT=4000
NODE_ENV=development

# PayPal Sandbox Credentials (Get from developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI Provider Configuration (Optional: system uses deterministic & heuristic fallbacks if omitted)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Cryptographic Receipt Signing Secret
RECEIPT_SECRET=holdfast_default_development_hmac_secret_2026
