# ==============================================================================
# Holdfast Protocol — Environment Configuration Template (.env.example)
#
# NOTE: Holdfast works out-of-the-box in EXPLORE DEMO mode with ZERO API keys.
# Set PAYPAL and AI keys below only if you wish to run live PayPal Sandbox
# and real LLM evaluations.
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
CORS_ORIGIN=*

# Frontend API Target (Vite development / container reverse proxy)
VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# PayPal Sandbox Credentials (Required ONLY for Live Sandbox Mode)
# Obtain from https://developer.paypal.com -> Dashboard -> Apps & Credentials
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional: system uses deterministic fallbacks if empty)
# Active options: gemini | groq | openai
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Cryptographic Security Configuration
# Used for HMAC-SHA256 acceptance receipt signatures
# ------------------------------------------------------------------------------
RECEIPT_SECRET=holdfast_receipt_hmac_secret_2026_change_in_production
